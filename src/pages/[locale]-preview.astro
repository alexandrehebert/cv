---
import favicon from "../favicon.png";
import CvPdfOnly from "../components/CvPdfOnly.astro";
import { locales, type Locale } from "../lib/cv";

const { locale = "fr" } = Astro.params as { locale?: string };
const currentLocale: Locale = (locales.includes(locale as Locale) ? locale : "fr") as Locale;
---

<html lang={currentLocale}>
  <head>
    <title>Alexandre Hebert - CV Preview (PDF)</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/png" href={favicon.src} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap");

      html {
        background: #f5f5f5;
      }

      body {
        margin: 0;
        padding: 20px;
        background: #f5f5f5;
      }

      .preview-header {
        max-width: 8.5in;
        margin: 0 auto 20px;
        text-align: center;
        font-size: 13px;
        color: #999;
        border-bottom: 2px dashed #ddd;
        padding-bottom: 10px;
        font-family: "IBM Plex Sans", Arial, sans-serif;
      }

      .pdf-page {
        max-width: 8.5in;
        margin: 0 auto;
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      /* Padding only in screen preview, not for printing */
      @media screen {
        .pdf-page {
          padding: 46px;
        }
      }

      @page {
        margin: 22mm;
        size: A4;
      }

      @media print {
        html {
          background: white;
        }
        body {
          background: white;
          padding: 0;
        }
        .preview-header {
          display: none;
        }
        .pdf-page {
          max-width: none;
          margin: 0;
          padding: 0;
          box-shadow: none;
          background: white;
        }
      }

      @media print and (color-gamut: srgb) {
        .pdf-page {
          padding: 0;
        }
      }
    </style>
  </head>

  <body>
    <div id="preview-pdf-root" class="pdf-page">
      <CvPdfOnly locale={currentLocale} />
    </div>

    <script>
      declare const html2pdf: any;

      const exportPreviewPdf = () => {
        const root = document.getElementById("preview-pdf-root");
        if (!root) return;

        const opt = {
          margin: [22, 22, 22, 22],
          filename: `resume-${document.documentElement.lang}.pdf`,
          image: { type: "jpeg", quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true },
          jsPDF: { orientation: "portrait", unit: "mm", format: "a4" },
          pagebreak: { mode: ["css", "legacy"] },
        };

        html2pdf().set(opt).from(root).save();
      };

      document.addEventListener("keydown", (event) => {
        const isPrintShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "p";
        if (!isPrintShortcut) return;

        // Keep native preview on Ctrl/Cmd+P. Use Shift+Ctrl/Cmd+P for direct download.
        if (!event.shiftKey) return;

        event.preventDefault();
        exportPreviewPdf();
      });
    </script>
  </body>
</html>
